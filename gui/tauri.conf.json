{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenFlux",
  "version": "0.1.1",
  "identifier": "ru.etersoft.openflux",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OpenFlux",
        "width": 920,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}